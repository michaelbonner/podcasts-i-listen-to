---
import "../styles/index.css";
import WideMonitor from "../components/WideMonitor.astro";

interface Props {
  title?: string;
  lcpImage?: { srcset: string; sizes: string; origin: string };
  /** Keep error pages out of search results. */
  noindex?: boolean;
}

const {
  title = "Podcasts I Listen To",
  lcpImage,
  noindex = false,
} = Astro.props;
const description =
  "The podcasts that Michael Bonner listens to. Just an easy way to share with my friends.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href="https://podcasts.michaelbonner.dev" />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light only" />
    <meta name="Description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://podcasts.michaelbonner.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://podcasts.michaelbonner.dev/og-image.jpg"
    />
    <meta name="theme-color" content="#f7f5ef" />

    {
      lcpImage && (
        <>
          <link rel="preconnect" href={lcpImage.origin} crossorigin />
          <link
            rel="preload"
            as="image"
            imagesrcset={lcpImage.srcset}
            imagesizes={lcpImage.sizes}
            type="image/webp"
            fetchpriority="high"
          />
        </>
      )
    }

    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-WKV6C4B");
    </script>
  </head>
  <body>
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WKV6C4B"
        height="0"
        width="0"
        style="display:none;visibility:hidden;"></iframe></noscript
    >

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header shell">
      <a class="wordmark" href="/">
        <svg
          aria-hidden="true"
          viewBox="0 0 32 32"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M5 19v-4a11 11 0 0 1 22 0v4"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"></path>
          <rect x="3" y="16" width="7" height="12" rx="3" fill="currentColor"
          ></rect>
          <rect x="22" y="16" width="7" height="12" rx="3" fill="currentColor"
          ></rect>
        </svg>
        <p class="m-0">podcasts <span>i listen to</span></p>
      </a>
      <nav class="site-nav" aria-label="Main">
        <a href="/#collection">The list</a>
        <a href="/#suggest">Suggest a podcast</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <WideMonitor />

    <footer class="site-footer shell">
      <p class="m-0">
        &copy; 2019&ndash;{new Date().getFullYear()}{" "}
        <a href="https://michaelbonner.dev/">Michael Bonner</a>
      </p>
      <div>
        <a href="https://github.com/michaelbonner/podcasts-i-listen-to">GitHub</a>
        <a href="https://www.instagram.com/michael__bonner/">Instagram</a>
        <a href="https://bootpackdigital.com/">
          Need a custom website or app? Hire the Utah app pros at Bootpack
          Digital
        </a>
      </div>
    </footer>
  </body>
</html>
