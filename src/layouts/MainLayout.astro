---
import "../styles/index.css";
import WideMonitor from "../components/WideMonitor.astro";

interface Props {
  title?: string;
  lcpImage?: { webp: string; jpg: string; origin: string };
}

const { title = "Podcasts I Listen To", lcpImage } = Astro.props;
const description =
  "The podcasts that Michael Bonner listens to. Just an easy way to share with my friends.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <link rel="canonical" href="https://podcasts.michaelbonner.dev" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light only" />
    <meta name="Description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://podcasts.michaelbonner.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://podcasts.michaelbonner.dev/og-image.jpg"
    />
    <meta name="theme-color" content="#ffffff" />

    <link rel="preconnect" href="https://rsms.me" crossorigin />
    <link rel="preload" as="style" href="https://rsms.me/inter/inter.css" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    {
      lcpImage && (
        <>
          <link rel="preconnect" href={lcpImage.origin} crossorigin />
          <link
            rel="preload"
            as="image"
            href={lcpImage.webp}
            type="image/webp"
            fetchpriority="high"
          />
        </>
      )
    }

    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-WKV6C4B");
    </script>
  </head>
  <body class="bg-white font-sans text-zinc-900 antialiased">
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WKV6C4BX"
        height="0"
        width="0"
        style="display:none;visibility:hidden;"></iframe></noscript
    >

    <div class="isolate">
      <header>
        <div
          class="mx-auto max-w-7xl px-4 pt-14 pb-12 sm:px-6 sm:pt-20 lg:px-8"
        >
          <div class="flex items-center gap-2.5">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              class="size-6 shrink-0 stroke-sky-600"
            >
              <path
                d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <p class="text-sm font-semibold text-sky-700">
              Michael Bonner&rsquo;s listening list
            </p>
          </div>
          <h1
            class="mt-4 max-w-[35ch] text-balance text-4xl font-semibold tracking-tight text-zinc-900 sm:max-w-[30ch] sm:text-5xl"
          >
            Some Podcasts I Listen To
          </h1>
          <p
            class="mt-4 max-w-[56ch] text-pretty text-base/7 text-zinc-600"
          >
            Everything here is something I actually listen to, rated and
            tagged. Search or filter the list &mdash; and if I&rsquo;m missing
            something good, send it my way.
          </p>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <WideMonitor />

      <footer class="border-t border-zinc-950/10">
        <div
          class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 text-center sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:text-left lg:px-8"
        >
          <div class="flex flex-col gap-2 sm:flex-row sm:gap-8">
            <p class="text-sm text-zinc-500">
              &copy; 2019-{new Date().getFullYear()}
              <a
                class="font-normal text-zinc-600 hover:text-zinc-900"
                href="https://michaelbonner.dev/">
                Michael Bonner
              </a>
            </p>
            <p class="text-sm text-zinc-500">
              <a
                class="font-normal text-zinc-600 hover:text-zinc-900"
                href="https://bootpackdigital.com/">
                Need a custom website or app? Hire the Utah app pros at
                Bootpack Digital
              </a>
            </p>
          </div>
          <div class="flex justify-center gap-4 sm:justify-end">
            <p>
              <a href="https://github.com/michaelbonner/podcasts-i-listen-to">
                <svg
                  class="size-5 fill-zinc-600 hover:fill-zinc-900"
                  viewBox="0 0 512 512"
                >
                  <title>GitHub</title>
                  <path
                    d="M256,32C132.3,32,32,134.9,32,261.7c0,101.5,64.2,187.5,153.2,217.9a17.56,17.56,0,0,0,3.8.4c8.3,0,11.5-6.1,11.5-11.4,0-5.5-.2-19.9-.3-39.1a102.4,102.4,0,0,1-22.6,2.7c-43.1,0-52.9-33.5-52.9-33.5-10.2-26.5-24.9-33.6-24.9-33.6-19.5-13.7-.1-14.1,1.4-14.1h.1c22.5,2,34.3,23.8,34.3,23.8,11.2,19.6,26.2,25.1,39.6,25.1a63,63,0,0,0,25.6-6c2-14.8,7.8-24.9,14.2-30.7-49.7-5.8-102-25.5-102-113.5,0-25.1,8.7-45.6,23-61.6-2.3-5.8-10-29.2,2.2-60.8a18.64,18.64,0,0,1,5-.5c8.1,0,26.4,3.1,56.6,24.1a208.21,208.21,0,0,1,112.2,0c30.2-21,48.5-24.1,56.6-24.1a18.64,18.64,0,0,1,5,.5c12.2,31.6,4.5,55,2.2,60.8,14.3,16.1,23,36.6,23,61.6,0,88.2-52.4,107.6-102.3,113.3,8,7.1,15.2,21.1,15.2,42.5,0,30.7-.3,55.5-.3,63,0,5.4,3.1,11.5,11.4,11.5a19.35,19.35,0,0,0,4-.4C415.9,449.2,480,363.1,480,261.7,480,134.9,379.7,32,256,32Z"
                  ></path>
                </svg>
              </a>
            </p>
            <p>
              <a
                href="https://www.instagram.com/michael__bonner/"
                aria-label="Instagram"
              >
                <svg
                  class="size-5 fill-zinc-600 hover:fill-zinc-900"
                  viewBox="0 0 512 512"
                >
                  <title>Instagram</title>
                  <path
                    d="M349.33,69.33a93.62,93.62,0,0,1,93.34,93.34V349.33a93.62,93.62,0,0,1-93.34,93.34H162.67a93.62,93.62,0,0,1-93.34-93.34V162.67a93.62,93.62,0,0,1,93.34-93.34H349.33m0-37.33H162.67C90.8,32,32,90.8,32,162.67V349.33C32,421.2,90.8,480,162.67,480H349.33C421.2,480,480,421.2,480,349.33V162.67C480,90.8,421.2,32,349.33,32Z"
                  ></path>
                  <path
                    d="M377.33,162.67a28,28,0,1,1,28-28A27.94,27.94,0,0,1,377.33,162.67Z"
                  ></path>
                  <path
                    d="M256,181.33A74.67,74.67,0,1,1,181.33,256,74.75,74.75,0,0,1,256,181.33M256,144A112,112,0,1,0,368,256,112,112,0,0,0,256,144Z"
                  ></path>
                </svg>
              </a>
            </p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>