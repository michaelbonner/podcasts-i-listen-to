---
import { Image } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";
import PodcastList from "../components/PodcastList.astro";
import ContactForm from "../components/ContactForm.astro";
import podcasts from "../data/podcasts";
import { ARTWORK_SIZES, artworkSrcset, artworkUrl } from "../lib/artwork";

export const prerender = true;

const itunesIds = podcasts.map((p) => p.itunesId).join(",");
const itunesRequest = await fetch(
  `https://itunes.apple.com/lookup?id=${itunesIds}`
);
const itunesData = await itunesRequest.json();

const enrichedPodcasts = podcasts.map((podcastData) => {
  const itunesPodcast = itunesData.results.find(
    (itunesDatum: { collectionId: number | string }) =>
      +itunesDatum.collectionId === +podcastData.itunesId
  );
  if (itunesPodcast) {
    podcastData.itunesData = itunesPodcast;
  } else {
    console.log(`no itunes data for ${podcastData.sortTitle}`);
  }
  return podcastData;
});

const sortedPodcasts = [...enrichedPodcasts].sort((a, b) => {
  const titleA = a.sortTitle.toUpperCase();
  const titleB = b.sortTitle.toUpperCase();
  if (titleA > titleB) return 1;
  if (titleA < titleB) return -1;
  return 0;
});

const heroTitles = ["Hidden Brain", "Revisionist History", "Serial"];
const heroCovers = heroTitles
  .map((title) => sortedPodcasts.find((p) => p.sortTitle === title))
  .filter((podcast) => podcast?.itunesData?.artworkUrl600)
  .map((podcast) => ({
    title: podcast!.sortTitle,
    src: artworkUrl(podcast!.itunesData.artworkUrl600, 400, "webp"),
  }));

const lcpArtworkUrl = sortedPodcasts[0]?.itunesData?.artworkUrl600 ?? "";
const lcpImage = lcpArtworkUrl
  ? {
      srcset: artworkSrcset(lcpArtworkUrl, "webp"),
      sizes: ARTWORK_SIZES,
      origin: new URL(lcpArtworkUrl).origin,
    }
  : undefined;

const site = Astro.site!;
const collectionSchema = {
  "@type": "CollectionPage",
  "@id": new URL("/#webpage", site).href,
  url: site.href,
  name: "Podcasts I Listen To",
  isPartOf: { "@id": new URL("/#website", site).href },
  about: { "@id": "https://michaelbonner.dev/#person" },
  mainEntity: {
    "@type": "ItemList",
    name: "Podcasts Michael Bonner listens to",
    numberOfItems: sortedPodcasts.length,
    itemListOrder: "https://schema.org/ItemListOrderAscending",
    itemListElement: sortedPodcasts.map((podcast, index) => {
      const itunes = podcast.itunesData ?? {};
      return {
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "PodcastSeries",
          name: itunes.collectionName ?? podcast.sortTitle,
          ...(itunes.collectionViewUrl && { url: itunes.collectionViewUrl }),
          ...(itunes.artworkUrl600 && { image: itunes.artworkUrl600 }),
          ...(itunes.feedUrl && { webFeed: itunes.feedUrl }),
          ...(itunes.artistName && {
            author: { "@type": "Organization", name: itunes.artistName },
          }),
          genre: podcast.tags,
          review: {
            "@type": "Review",
            author: { "@id": "https://michaelbonner.dev/#person" },
            reviewRating: {
              "@type": "Rating",
              ratingValue: podcast.rating,
              bestRating: 5,
              worstRating: 1,
            },
          },
        },
      };
    }),
  },
};
---

<MainLayout lcpImage={lcpImage} schema={[collectionSchema]}>
  <section class="hero shell">
    <div>
      <p class="eyebrow">A personal collection by Michael Bonner</p>
      <h1>Good things<br />for your <em>ears.</em></h1>
      <p class="hero-description">
        The podcasts I keep coming back to, shared so my friends can find
        something good to listen to.
      </p>
      <a class="hero-link" href="#collection">
        Browse the list <span aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="record"></div>
      {
        heroCovers.map((cover) => (
          <Image
            class="hero-cover"
            src={cover.src}
            alt=""
            width="400"
            height="400"
            loading="lazy"
          />
        ))
      }
    </div>
  </section>

  <section class="collection shell" id="collection">
    <PodcastList podcasts={sortedPodcasts} />
  </section>

  <section class="suggestion shell" id="suggest">
    <div class="suggestion-copy">
      <p class="eyebrow">Suggestions welcome</p>
      <h2>What am I<br /><em>missing?</em></h2>
      <p>
        Let me know what you&apos;re listening to. I&apos;m always looking for
        new podcasts.
      </p>
    </div>
    <ContactForm />
  </section>
</MainLayout>
