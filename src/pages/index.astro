---
import MainLayout from "../layouts/MainLayout.astro";
import PodcastList from "../components/PodcastList.astro";
import ContactForm from "../components/ContactForm.astro";
import podcasts from "../data/podcasts";

export const prerender = true;

const itunesIds = podcasts.map((p) => p.itunesId).join(",");
const itunesRequest = await fetch(
  `https://itunes.apple.com/lookup?id=${itunesIds}`
);
const itunesData = await itunesRequest.json();

const enrichedPodcasts = podcasts.map((podcastData) => {
  const itunesPodcast = itunesData.results.find(
    (itunesDatum: { collectionId: number | string }) =>
      +itunesDatum.collectionId === +podcastData.itunesId
  );
  if (itunesPodcast) {
    podcastData.itunesData = itunesPodcast;
  } else {
    console.log(`no itunes data for ${podcastData.sortTitle}`);
  }
  return podcastData;
});

const sortedPodcasts = [...enrichedPodcasts].sort((a, b) => {
  const titleA = a.sortTitle.toUpperCase();
  const titleB = b.sortTitle.toUpperCase();
  if (titleA > titleB) return 1;
  if (titleA < titleB) return -1;
  return 0;
});

const lcpArtworkUrl = sortedPodcasts[0]?.itunesData?.artworkUrl600 ?? "";
const lcpImage = lcpArtworkUrl
  ? {
      webp: lcpArtworkUrl.replace("600x600bb.jpg", "200x200bb.webp"),
      jpg: lcpArtworkUrl.replace("600x600bb.jpg", "200x200bb.jpg"),
      origin: new URL(lcpArtworkUrl).origin,
    }
  : undefined;
---

<MainLayout lcpImage={lcpImage}>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <PodcastList podcasts={sortedPodcasts} />
  </section>

  <section
    class="mx-auto mt-20 max-w-7xl px-4 pb-20 sm:px-6 lg:px-8"
  >
    <div
      class="rounded-2xl bg-sky-50 p-6 ring-1 ring-sky-100 sm:p-10"
    >
      <div class="flex items-start gap-5">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          class="mt-1 size-6 shrink-0 stroke-sky-600"
        >
          <path
            d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <div class="max-w-2xl">
          <h2
            class="text-2xl font-semibold tracking-tight text-balance text-zinc-900 sm:text-3xl"
          >
            Got a podcast I should check out?
          </h2>
          <p class="mt-3 text-base/7 text-pretty text-zinc-600">
            Let me know what you&rsquo;re listening to. I&rsquo;m always
            looking for new podcasts.
          </p>
        </div>
      </div>
      <div class="mt-6">
        <ContactForm />
      </div>
    </div>
  </section>
</MainLayout>