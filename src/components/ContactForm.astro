---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form
  action="/api/podcast-suggestion"
  class="transition-opacity"
  data-contact-form
  method="POST"
>
  <div
    data-error
    class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 py-2.5 px-4"
  >
    <p data-error-message class="text-sm/6 text-red-700"></p>
  </div>
  <div class="mt-2 mb-6 grid gap-4 sm:grid-cols-2">
    <div>
      <label
        class="mb-1.5 block text-sm/6 font-semibold text-zinc-900"
        for="your-name"
      >
        Your Name
      </label>
      <input
        autocomplete="name"
        class="block w-full rounded-lg border-0 bg-zinc-50 py-2.5 px-3.5 text-base text-zinc-900 ring-1 ring-zinc-950/10 placeholder:text-zinc-400 focus:bg-white focus:outline-2 focus:-outline-offset-1 focus:outline-sky-600 sm:text-sm"
        id="your-name"
        name="your_name"
        required
        type="text"
      />
    </div>
    <div>
      <label
        class="mb-1.5 block text-sm/6 font-semibold text-zinc-900"
        for="podcast-name"
      >
        Podcast Name
      </label>
      <input
        class="block w-full rounded-lg border-0 bg-zinc-50 py-2.5 px-3.5 text-base text-zinc-900 ring-1 ring-zinc-950/10 placeholder:text-zinc-400 focus:bg-white focus:outline-2 focus:-outline-offset-1 focus:outline-sky-600 sm:text-sm"
        id="podcast-name"
        name="podcast_name"
        required
        type="text"
      />
    </div>
    <div class="sm:col-span-2">
      <label
        class="mb-1.5 block text-sm/6 font-semibold text-zinc-900"
        for="podcast-url"
      >
        Podcast URL
      </label>
      <input
        class="block w-full rounded-lg border-0 bg-zinc-50 py-2.5 px-3.5 text-base text-zinc-900 ring-1 ring-zinc-950/10 placeholder:text-zinc-400 focus:bg-white focus:outline-2 focus:-outline-offset-1 focus:outline-sky-600 sm:text-sm"
        id="podcast-url"
        name="podcast_url"
        placeholder="https://"
        required
        type="url"
      />
    </div>
  </div>
  <div data-success class="hidden pt-6 border-t border-zinc-950/10">
    <h3 class="text-base font-semibold text-sky-700">
      Thank you for your recommendation!
    </h3>
  </div>
  <div class="flex flex-wrap gap-6 items-center justify-between mt-6">
    <div
      class="cf-turnstile"
      data-sitekey={siteKey}
      data-callback="onTurnstileSuccess"
      data-expired-callback="onTurnstileExpired"
      data-theme="light"
    >
    </div>
    <button
      data-submit-btn
      disabled
      class="rounded-lg bg-sky-600 px-3 py-2 text-sm font-semibold text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 hover:bg-sky-500 disabled:cursor-not-allowed disabled:opacity-40"
      type="submit"
    >
      Submit
    </button>
  </div>
</form>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
></script>

<script>
  declare global {
    interface Window {
      onTurnstileSuccess?: (token: string) => void;
      onTurnstileExpired?: () => void;
    }
  }

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const submitBtn =
      form.querySelector<HTMLButtonElement>("[data-submit-btn]")!;
    const errorBox = form.querySelector<HTMLElement>("[data-error]")!;
    const errorMessage = form.querySelector<HTMLElement>(
      "[data-error-message]",
    )!;
    const successBox = form.querySelector<HTMLElement>("[data-success]")!;
    const yourName = form.querySelector<HTMLInputElement>("#your-name")!;
    const podcastName = form.querySelector<HTMLInputElement>("#podcast-name")!;
    const podcastUrl = form.querySelector<HTMLInputElement>("#podcast-url")!;

    let token = "";
    let submitting = false;

    const updateSubmitState = () => {
      const disabled = submitting || !token;
      submitBtn.disabled = disabled;
      form.classList.toggle("opacity-50", submitting);
    };

    window.onTurnstileSuccess = (newToken: string) => {
      token = newToken;
      updateSubmitState();
    };

    window.onTurnstileExpired = () => {
      token = "";
      updateSubmitState();
    };

    const showError = (message: string) => {
      errorMessage.textContent = message;
      errorBox.classList.remove("hidden");
    };

    const hideError = () => {
      errorBox.classList.add("hidden");
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideError();
      submitting = true;
      updateSubmitState();

      try {
        const submit = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            your_name: yourName.value,
            podcast_name: podcastName.value,
            podcast_url: podcastUrl.value,
            token,
          }),
        });
        const response = await submit.json();
        if (response.success) {
          yourName.value = "";
          podcastName.value = "";
          podcastUrl.value = "";
          successBox.classList.remove("hidden");
        } else {
          showError(response.data);
        }
      } catch (error) {
        console.error("submit error", error);
        showError(
          "There was a problem connecting to the API. Please let me know so I can get it fixed.",
        );
      } finally {
        submitting = false;
        updateSubmitState();
      }
    });

    updateSubmitState();
  }
</script>