---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form
  action="/api/podcast-suggestion"
  class="transition-opacity"
  data-contact-form
  method="POST"
>
  <div
    data-error
    class="hidden py-2 px-4 mb-4 text-accent bg-paper rounded-md border border-accent"
  >
    <p data-error-message></p>
  </div>
  <div class="grid gap-5">
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label
          class="block mb-2 font-mono text-xs tracking-wider uppercase"
          for="your-name"
        >
          Your Name
        </label>
        <input
          autocomplete="name"
          class="block py-3 px-4 w-full leading-tight bg-paper rounded-md border border-line appearance-none focus:bg-white focus:border-ink focus:outline-hidden"
          id="your-name"
          name="your_name"
          required
          type="text"
        />
      </div>
      <div>
        <label
          class="block mb-2 font-mono text-xs tracking-wider uppercase"
          for="podcast-name"
        >
          Podcast Name
        </label>
        <input
          class="block py-3 px-4 w-full leading-tight bg-paper rounded-md border border-line appearance-none focus:bg-white focus:border-ink focus:outline-hidden"
          id="podcast-name"
          name="podcast_name"
          required
          type="text"
        />
      </div>
    </div>
    <div>
      <label
        class="block mb-2 font-mono text-xs tracking-wider uppercase"
        for="podcast-url"
      >
        Podcast URL
      </label>
      <input
        class="block py-3 px-4 w-full leading-tight bg-paper rounded-md border border-line appearance-none focus:bg-white focus:border-ink focus:outline-hidden"
        id="podcast-url"
        name="podcast_url"
        placeholder="https://"
        required
        type="url"
      />
    </div>
    <div data-success class="hidden pt-5 border-t border-line">
      <h3 class="m-0 text-xl font-bold">
        Thank you for your recommendation!
      </h3>
    </div>
    <div class="flex flex-wrap gap-6 justify-between items-end">
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-callback="onTurnstileSuccess"
        data-expired-callback="onTurnstileExpired"
        data-theme="light"
      >
      </div>
      <button data-submit-btn disabled class="button" type="submit">
        Send suggestion
      </button>
    </div>
  </div>
</form>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
></script>

<script>
  declare global {
    interface Window {
      onTurnstileSuccess?: (token: string) => void;
      onTurnstileExpired?: () => void;
    }
  }

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const submitBtn =
      form.querySelector<HTMLButtonElement>("[data-submit-btn]")!;
    const errorBox = form.querySelector<HTMLElement>("[data-error]")!;
    const errorMessage = form.querySelector<HTMLElement>(
      "[data-error-message]",
    )!;
    const successBox = form.querySelector<HTMLElement>("[data-success]")!;
    const yourName = form.querySelector<HTMLInputElement>("#your-name")!;
    const podcastName = form.querySelector<HTMLInputElement>("#podcast-name")!;
    const podcastUrl = form.querySelector<HTMLInputElement>("#podcast-url")!;

    let token = "";
    let submitting = false;

    const updateSubmitState = () => {
      const disabled = submitting || !token;
      submitBtn.disabled = disabled;
      form.classList.toggle("opacity-50", submitting);
    };

    window.onTurnstileSuccess = (newToken: string) => {
      token = newToken;
      updateSubmitState();
    };

    window.onTurnstileExpired = () => {
      token = "";
      updateSubmitState();
    };

    const showError = (message: string) => {
      errorMessage.textContent = message;
      errorBox.classList.remove("hidden");
    };

    const hideError = () => {
      errorBox.classList.add("hidden");
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideError();
      submitting = true;
      updateSubmitState();

      try {
        const submit = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            your_name: yourName.value,
            podcast_name: podcastName.value,
            podcast_url: podcastUrl.value,
            token,
          }),
        });
        const response = await submit.json();
        if (response.success) {
          yourName.value = "";
          podcastName.value = "";
          podcastUrl.value = "";
          successBox.classList.remove("hidden");
        } else {
          showError(response.data);
        }
      } catch (error) {
        console.error("submit error", error);
        showError(
          "There was a problem connecting to the API. Please let me know so I can get it fixed.",
        );
      } finally {
        submitting = false;
        updateSubmitState();
      }
    });

    updateSubmitState();
  }
</script>
