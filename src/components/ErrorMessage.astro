---
interface Props {
  eyebrow: string;
  heading: string;
}

const { eyebrow, heading } = Astro.props;
---

<section class="error-page shell">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{heading}</h1>
  <div class="body">
    <slot />
  </div>
  <a class="button mt-6" href="/">Back to the podcast list</a>
</section>
