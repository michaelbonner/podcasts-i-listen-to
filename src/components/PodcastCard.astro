---
import type { Podcast } from "../types/Podcast";
import Star from "./Star.astro";

interface Props {
  podcast: Podcast;
  eager?: boolean;
}

const { podcast, eager = false } = Astro.props;

const artworkUrl = podcast.itunesData?.artworkUrl600 ?? "";
const artwork200Webp = artworkUrl.replace("600x600bb.jpg", "200x200bb.webp");
const artwork200Jpg = artworkUrl.replace("600x600bb.jpg", "200x200bb.jpg");
---

<article
  data-podcast-card
  data-sort-title={podcast.sortTitle}
  data-rating={podcast.rating}
  data-tags={podcast.tags.join("|")}
  class="flex gap-4 rounded-xl bg-white ring-1 ring-zinc-950/10 sm:gap-5"
>
  <a
    class="h-full shrink-0 self-stretch"
    href={podcast.itunesData?.collectionViewUrl}
    target="_blank"
    rel="noopener noreferrer"
    title={`${podcast.itunesData?.collectionName} Poster`}
  >
    <picture>
      <source type="image/webp" srcset={artwork200Webp} />
      <img
        class="h-full w-[88px] rounded-l-xl object-cover sm:w-[104px]"
        alt={`${podcast.itunesData?.collectionName} Poster`}
        height={200}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        decoding={eager ? "sync" : "async"}
        src={artwork200Jpg}
        width={200}
      />
    </picture>
  </a>
  <div class="min-w-0 flex-1 py-4 pr-5 sm:py-5">
    <h2 class="truncate text-base/6 font-semibold">
      <a
        class="hover:text-sky-700"
        href={podcast.itunesData?.collectionViewUrl}
        rel="noopener noreferrer"
        target="_blank"
        set:html={podcast.itunesData?.collectionName}
      />
    </h2>
    <div class="flex gap-1 mt-2">
      <Star filled={podcast.rating > 0} />
      <Star filled={podcast.rating > 1} />
      <Star filled={podcast.rating > 2} />
      <Star filled={podcast.rating > 3} />
      <Star filled={podcast.rating > 4} />
    </div>
    <div class="flex flex-wrap gap-1.5 mt-3">
      {
        podcast.tags.map((tag) => (
          <button
            class="rounded-full bg-zinc-100 px-2 py-1 text-xs font-medium text-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 data-active:bg-sky-100 data-active:text-sky-700"
            data-card-tag={tag}
            type="button"
          >
            {tag}
          </button>
        ))
      }
    </div>
  </div>
</article>