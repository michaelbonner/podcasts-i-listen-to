---
import type { Podcast } from "../types/Podcast";
import Star from "./Star.astro";
import { ARTWORK_SIZES, artworkSrcset, artworkUrl } from "../lib/artwork";

interface Props {
  podcast: Podcast;
  eager?: boolean;
}

const { podcast, eager = false } = Astro.props;

const title = podcast.itunesData?.collectionName || podcast.sortTitle;
const url =
  podcast.itunesData?.collectionViewUrl ||
  `https://podcasts.apple.com/podcast/id${podcast.itunesId}`;
const artwork = podcast.itunesData?.artworkUrl600 ?? "";
---

<article
  class="podcast-card"
  data-podcast-card
  data-sort-title={podcast.sortTitle}
  data-rating={podcast.rating}
  data-tags={podcast.tags.join("|")}
>
  <a
    class="artwork-link"
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Listen to ${title} on Apple Podcasts`}
  >
    {
      artwork && (
        <picture>
          <source
            type="image/webp"
            srcset={artworkSrcset(artwork, "webp")}
            sizes={ARTWORK_SIZES}
          />
          <img
            src={artworkUrl(artwork, 300, "jpg")}
            srcset={artworkSrcset(artwork, "jpg")}
            sizes={ARTWORK_SIZES}
            alt=""
            width="300"
            height="300"
            loading={eager ? "eager" : "lazy"}
            fetchpriority={eager ? "high" : "auto"}
            decoding="async"
          />
        </picture>
      )
    }
    <span class="listen-overlay" aria-hidden="true">
      Listen on Apple Podcasts ↗
    </span>
  </a>
  <div class="card-meta">
    <div class="card-tags">
      {
        podcast.tags.map((tag) => (
          <button
            type="button"
            data-card-tag={tag}
            aria-label={`Show ${tag} podcasts`}
          >
            {tag}
          </button>
        ))
      }
    </div>
    <span
      class="card-rating"
      role="img"
      aria-label={`${podcast.rating} out of 5 stars`}
    >
      {[1, 2, 3, 4, 5].map((n) => <Star filled={podcast.rating >= n} />)}
    </span>
  </div>
  <h3>
    <a href={url} target="_blank" rel="noopener noreferrer">{title}</a>
  </h3>
  <p class="publisher">{podcast.itunesData?.artistName}</p>
</article>
