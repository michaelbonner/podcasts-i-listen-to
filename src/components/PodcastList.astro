---
import PodcastCard from "./PodcastCard.astro";
import type { Podcast } from "../types/Podcast";

interface Props {
  podcasts: Podcast[];
}

const { podcasts } = Astro.props;

const tags = [...new Set(podcasts.flatMap((podcast) => podcast.tags))].sort();
---

<div data-podcast-list>
  <div class="collection-heading">
    <div>
      <p class="eyebrow">The collection</p>
      <h2>A little of everything</h2>
    </div>
    <p class="collection-count">{podcasts.length} podcasts</p>
  </div>

  <div class="collection-toolbar">
    <div class="category-tabs" role="group" aria-label="Filter by category">
      <button type="button" data-tag-filter="" aria-pressed="true">
        All <span>{podcasts.length}</span>
      </button>
      {
        tags.map((tag) => (
          <button type="button" data-tag-filter={tag} aria-pressed="false">
            {tag}
          </button>
        ))
      }
    </div>
    <label class="search-box">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="m16 16 5 5"></path>
      </svg>
      <input
        data-search-input
        type="search"
        placeholder="Search podcasts"
        aria-label="Search podcasts"
      />
    </label>
  </div>

  <div class="collection-options">
    <p data-result-status aria-live="polite">
      Showing all {podcasts.length} podcasts
    </p>
    <div>
      <label>
        <input type="checkbox" data-favorites />
        Five stars only
      </label>
      <label>
        Sort by
        <select data-sort>
          <option value="title">Name</option>
          <option value="rating">Rating</option>
        </select>
      </label>
    </div>
  </div>

  <div class="podcast-grid" data-podcast-grid>
    {
      podcasts.map((podcast, index) => (
        <PodcastCard podcast={podcast} eager={index === 0} />
      ))
    }
  </div>

  <div class="empty-state" data-empty-state hidden>
    <h3>No podcasts match that.</h3>
    <p>Know a good one? Suggest it below.</p>
    <button type="button" class="button" data-reset>Clear filters</button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-podcast-list]");
  if (root) {
    const grid = root.querySelector<HTMLElement>("[data-podcast-grid]")!;
    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>("[data-podcast-card]"),
    );
    const searchInput =
      root.querySelector<HTMLInputElement>("[data-search-input]")!;
    const favoritesInput =
      root.querySelector<HTMLInputElement>("[data-favorites]")!;
    const sortSelect = root.querySelector<HTMLSelectElement>("[data-sort]")!;
    const emptyState = root.querySelector<HTMLElement>("[data-empty-state]")!;
    const resultStatus = root.querySelector<HTMLElement>(
      "[data-result-status]",
    )!;
    const tagButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-tag-filter]"),
    );
    const tags = tagButtons.map((button) => button.dataset.tagFilter);

    let tagFilter = "";

    const applyFilters = () => {
      const search = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      for (const card of cards) {
        const visible =
          (card.dataset.sortTitle || "").toLowerCase().includes(search) &&
          (!tagFilter || card.dataset.tags?.split("|").includes(tagFilter)) &&
          (!favoritesInput.checked || card.dataset.rating === "5");
        card.hidden = !visible;
        if (visible) visibleCount++;
      }

      for (const button of tagButtons) {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.tagFilter === tagFilter),
        );
      }

      emptyState.hidden = visibleCount > 0;
      resultStatus.textContent =
        visibleCount === cards.length
          ? `Showing all ${cards.length} podcasts`
          : `Showing ${visibleCount} of ${cards.length} podcasts`;
    };

    const applySort = () => {
      const byRating = sortSelect.value === "rating";
      const sorted = [...cards].sort(
        (a, b) =>
          (byRating ? Number(b.dataset.rating) - Number(a.dataset.rating) : 0) ||
          (a.dataset.sortTitle || "").localeCompare(b.dataset.sortTitle || ""),
      );
      grid.append(...sorted);
    };

    const setTagFilter = (value: string) => {
      tagFilter = value;
      applyFilters();
    };

    for (const button of tagButtons) {
      button.addEventListener("click", () =>
        setTagFilter(button.dataset.tagFilter || ""),
      );
    }

    root.querySelectorAll<HTMLElement>("[data-card-tag]").forEach((button) => {
      button.addEventListener("click", () => {
        const value = button.dataset.cardTag || "";
        setTagFilter(tagFilter === value ? "" : value);
        root.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    searchInput.addEventListener("input", applyFilters);
    favoritesInput.addEventListener("change", applyFilters);
    sortSelect.addEventListener("change", applySort);

    root.querySelector("[data-reset]")!.addEventListener("click", () => {
      searchInput.value = "";
      favoritesInput.checked = false;
      setTagFilter("");
    });

    const params = new URLSearchParams(location.search);
    searchInput.value = params.get("search") || "";
    const filterParam = params.get("filter");
    if (filterParam && tags.includes(filterParam)) tagFilter = filterParam;

    applyFilters();
  }
</script>
