---
import PodcastCard from "./PodcastCard.astro";
import Star from "./Star.astro";
import type { Podcast } from "../types/Podcast";
import type { Tag } from "../types/Tag";

interface Props {
  podcasts: Podcast[];
}

const { podcasts } = Astro.props;

const tags: Tag[] = Array.from(
  new Set(
    podcasts
      .map((podcast) => podcast.tags)
      .flat()
      .sort()
  )
);
---

<div data-podcast-list>
  {/* Search + filters toolbar */}
  <div class="flex flex-wrap justify-end gap-2">
    <div>
      <div data-search-closed class="flex">
        <button
          type="button"
          data-search-open-btn
          class="flex items-center gap-1.5 rounded-lg bg-white py-2 pr-2.5 pl-3 text-sm font-semibold text-zinc-700 ring-1 ring-zinc-950/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 hover:bg-zinc-50"
        >
          <span>Search</span>
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class="size-5 shrink-0 stroke-zinc-400"
          >
            <path
              fill-rule="evenodd"
              d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </div>
      <div data-search-open class="hidden items-center">
        <div class="relative">
          <svg
            viewBox="0 0 20 20"
            fill="none"
            class="pointer-events-none absolute top-1/2 left-3 size-5 -translate-y-1/2 stroke-zinc-400"
          >
            <path
              fill-rule="evenodd"
              d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z"
              clip-rule="evenodd"></path>
          </svg>
          <label class="sr-only" for="search">Search podcasts</label>
          <input
            class="block w-56 rounded-lg bg-white py-2 pr-9 pl-10 text-base text-zinc-900 ring-1 ring-zinc-950/10 sm:w-64 sm:text-sm focus:outline-2 focus:-outline-offset-1 focus:outline-sky-600"
            name="search"
            id="search"
            data-search-input
            type="text"
          />
          <button
            type="button"
            data-search-clear-btn
            class="hidden absolute top-1/2 right-2 size-6 -translate-y-1/2 items-center justify-center rounded-full text-zinc-500 hover:text-zinc-700"
          >
            <svg viewBox="0 0 20 20" fill="none" class="size-5">
              <path
                d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"
                fill="currentColor"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
    <button
      type="button"
      data-filters-toggle
      class="flex items-center gap-1.5 rounded-lg bg-white py-2 pr-2.5 pl-3 text-sm font-semibold text-zinc-700 ring-1 ring-zinc-950/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 hover:bg-zinc-50 data-active:bg-sky-50 data-active:text-sky-700"
    >
      <span>Filters</span>
      <svg
        data-filters-icon
        viewBox="0 0 20 20"
        fill="none"
        class="size-5 shrink-0 stroke-zinc-400"
      >
        <path
          d="M2.695 14.763l-1.262 3.155a.5.5 0 0 0 .65.657l3.155-1.262a4 4 0 0 0 1.872-.975l.002-.001a4 4 0 0 0 .047-.047L18.438 5.91a2.25 2.25 0 0 0 0-3.182l-.182-.182a2.25 2.25 0 0 0-3.182 0L3.795 13.782a4 4 0 0 0-.975 1.872ZM16.72 4.36l-.181.181-1.018 1.018-1.08-1.08 1.199-1.2a.75.75 0 0 1 1.06 0l.182.181a.75.75 0 0 1 0 1.061Z"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  {/* Filters panel */}
  <div
    data-filters-panel
    class="mt-4 hidden flex-col gap-6 rounded-xl bg-zinc-50 p-5 ring-1 ring-zinc-950/5 sm:flex-row sm:gap-10"
  >
    <div>
      <h2 class="text-sm font-semibold text-zinc-900">Rating</h2>
      <div class="mt-2.5 flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-rating-filter="0"
          class="rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-zinc-700 ring-1 ring-zinc-950/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 data-active:bg-sky-600 data-active:text-white data-active:ring-sky-600"
        >
          All
        </button>
        <button
          type="button"
          data-rating-filter="4"
          class="flex items-center gap-0.5 rounded-full bg-white py-1.5 pr-3 pl-3.5 text-sm font-semibold text-zinc-700 ring-1 ring-zinc-950/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 data-active:bg-sky-600 data-active:text-white data-active:ring-sky-600"
        >
          <Star filled={true} />
          <Star filled={true} />
          <Star filled={true} />
          <Star filled={true} />
          <span class="font-semibold">+</span>
        </button>
        <button
          type="button"
          data-rating-filter="5"
          class="flex items-center gap-0.5 rounded-full bg-white py-1.5 pr-3 pl-3.5 text-sm font-semibold text-zinc-700 ring-1 ring-zinc-950/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 data-active:bg-sky-600 data-active:text-white data-active:ring-sky-600"
        >
          <Star filled={true} />
          <Star filled={true} />
          <Star filled={true} />
          <Star filled={true} />
          <Star filled={true} />
        </button>
      </div>
    </div>
    <div class="min-w-0 flex-1">
      <h2 class="text-sm font-semibold text-zinc-900">Tags</h2>
      <div
        data-tag-filters
        class="mt-2.5 flex flex-wrap items-center gap-2"
      >
        <button
          type="button"
          data-tag-filter=""
          class="rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-zinc-700 ring-1 ring-zinc-950/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 data-active:bg-sky-600 data-active:text-white data-active:ring-sky-600"
        >
          All
        </button>
        {
          tags.map((tag) => (
            <button
              type="button"
              data-tag-filter={tag}
              class="rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-zinc-700 ring-1 ring-zinc-950/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 data-active:bg-sky-600 data-active:text-white data-active:ring-sky-600"
            >
              {tag}
            </button>
          ))
        }
      </div>
    </div>
  </div>
  {/* End filters */}

  {/* Podcast grid */}
  <div
    data-podcast-grid
    class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3"
  >
    {podcasts.map((podcast, index) => <PodcastCard podcast={podcast} eager={index === 0} />)}
  </div>
  <div data-empty-state class="mt-6 hidden">
    <div class="rounded-xl bg-zinc-50 p-8 text-center ring-1 ring-zinc-950/5">
      <h2 class="text-base font-semibold text-zinc-900">
        No podcasts match that filter
      </h2>
      <p class="mt-2 text-sm/6 text-zinc-600">
        Maybe suggest that podcast to me? I&rsquo;m always looking for new
        ones. Use the form below.
      </p>
    </div>
  </div>
  {/* End podcast grid */}
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-podcast-list]");
  if (root) {
    const grid = root.querySelector<HTMLElement>("[data-podcast-grid]")!;
    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>("[data-podcast-card]")
    );
    const emptyState = root.querySelector<HTMLElement>("[data-empty-state]")!;
    const searchClosed = root.querySelector<HTMLElement>("[data-search-closed]")!;
    const searchOpen = root.querySelector<HTMLElement>("[data-search-open]")!;
    const searchInput = root.querySelector<HTMLInputElement>("[data-search-input]")!;
    const searchOpenBtn = root.querySelector<HTMLElement>("[data-search-open-btn]")!;
    const searchClearBtn = root.querySelector<HTMLElement>("[data-search-clear-btn]")!;
    const filtersToggleBtn = root.querySelector<HTMLElement>("[data-filters-toggle]")!;
    const filtersPanel = root.querySelector<HTMLElement>("[data-filters-panel]")!;
    const tagFilterButtons = Array.from(
      root.querySelectorAll<HTMLElement>("[data-tag-filter]")
    );
    const ratingButtons = Array.from(
      root.querySelectorAll<HTMLElement>("[data-rating-filter]")
    );

    let ratingFilter = 0;
    let tagFilter: string | null = null;
    let search = "";
    let filtersOpen = false;
    let searchOpenState = false;

    const applyFilters = () => {
      let visibleCount = 0;
      for (const card of cards) {
        const sortTitle = (
          card.getAttribute("data-sort-title") || ""
        ).toLowerCase();
        const rating = parseInt(card.getAttribute("data-rating") || "0", 10);
        const cardTags = (card.getAttribute("data-tags") || "")
          .split("|")
          .filter(Boolean);
        const visible =
          (!search || sortTitle.includes(search.toLowerCase())) &&
          rating >= ratingFilter &&
          (!tagFilter || cardTags.includes(tagFilter));
        card.style.display = visible ? "" : "none";
        if (visible) visibleCount++;
      }
      emptyState.classList.toggle("hidden", visibleCount > 0);
    };

    const updateRatingButtons = () => {
      for (const btn of ratingButtons) {
        const value = parseInt(btn.getAttribute("data-rating-filter") || "0", 10);
        btn.toggleAttribute("data-active", value === ratingFilter);
      }
    };

    const updateTagButtons = () => {
      for (const btn of tagFilterButtons) {
        const raw = btn.getAttribute("data-tag-filter");
        const value = raw === "" ? null : raw;
        btn.toggleAttribute("data-active", value === tagFilter);
      }
      const cardTagPills = root.querySelectorAll<HTMLElement>("[data-card-tag]");
      cardTagPills.forEach((pill) => {
        const value = pill.getAttribute("data-card-tag");
        pill.toggleAttribute("data-active", value === tagFilter);
      });
    };

    const updateFiltersToggleAppearance = () => {
      const active = filtersOpen || ratingFilter > 0 || tagFilter !== null;
      filtersToggleBtn.toggleAttribute("data-active", active);
    };

    const setFiltersOpen = (open: boolean) => {
      filtersOpen = open;
      filtersPanel.classList.toggle("hidden", !open);
      filtersPanel.classList.toggle("flex", open);
      updateFiltersToggleAppearance();
    };

    const setSearchOpen = (open: boolean) => {
      searchOpenState = open;
      searchClosed.classList.toggle("hidden", open);
      searchOpen.classList.toggle("hidden", !open);
      searchOpen.classList.toggle("flex", open);
      if (open) {
        searchInput.focus();
      }
    };

    const setSearch = (value: string) => {
      search = value;
      if (searchInput.value !== value) searchInput.value = value;
      searchClearBtn.classList.toggle("hidden", value.length === 0);
      searchClearBtn.classList.toggle("flex", value.length > 0);
      applyFilters();
    };

    const setRatingFilter = (value: number) => {
      ratingFilter = value;
      updateRatingButtons();
      updateFiltersToggleAppearance();
      applyFilters();
    };

    const setTagFilter = (value: string | null) => {
      tagFilter = value;
      updateTagButtons();
      updateFiltersToggleAppearance();
      applyFilters();
    };

    searchOpenBtn.addEventListener("click", () => setSearchOpen(true));
    searchClearBtn.addEventListener("click", () => setSearch(""));
    searchInput.addEventListener("input", (e) => {
      setSearch((e.target as HTMLInputElement).value);
    });
    searchInput.addEventListener("keyup", (e) => {
      if (e.key !== "Escape") return;
      if (search !== "") {
        setSearch("");
      } else {
        setSearchOpen(false);
      }
    });

    filtersToggleBtn.addEventListener("click", () => setFiltersOpen(!filtersOpen));

    for (const btn of ratingButtons) {
      btn.addEventListener("click", () => {
        const value = parseInt(btn.getAttribute("data-rating-filter") || "0", 10);
        setRatingFilter(value);
      });
    }

    for (const btn of tagFilterButtons) {
      btn.addEventListener("click", () => {
        const raw = btn.getAttribute("data-tag-filter");
        setTagFilter(raw === "" ? null : raw);
      });
    }

    root.querySelectorAll<HTMLElement>("[data-card-tag]").forEach((pill) => {
      pill.addEventListener("click", () => {
        const value = pill.getAttribute("data-card-tag");
        setTagFilter(tagFilter === value ? null : value);
      });
    });

    const params = new URL(document.location.toString()).searchParams;
    const searchParam = params.get("search");
    if (searchParam) {
      setSearchOpen(true);
      setSearch(searchParam);
    }
    const filterParam = params.get("filter");
    if (filterParam) {
      setFiltersOpen(true);
      for (const btn of tagFilterButtons) {
        const raw = btn.getAttribute("data-tag-filter");
        if (raw !== "" && raw !== filterParam) {
          btn.style.display = "none";
        }
      }
    }

    applyFilters();
  }
</script>